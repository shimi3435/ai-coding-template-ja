{
  "contract_version": 1,
  "tool": "openspec",
  "supported_version": "1.3.1",
  "version_probe": "openspec --version",
  "apply_probe": "openspec instructions apply --change fixture-change --json",
  "limits": {
    "change_id_bytes": 128,
    "canonical_files": 64,
    "bytes_per_file": 1048576,
    "bytes_total": 4194304,
    "tasks": 4096
  },
  "positive": {
    "version_exit_code": 0,
    "version_stdout": "1.3.1\n",
    "apply_exit_code": 0,
    "apply_stdout_fixture": "apply-positive.json",
    "expected_route": "json"
  },
  "negative": [
    {
      "name": "version-probe-nonzero",
      "version_exit_code": 1,
      "version_stdout": "1.3.1\n",
      "apply_exit_code": 0,
      "apply_stdout_fixture": "apply-positive.json",
      "expected_route": "markdown-fallback"
    },
    {
      "name": "version-mismatch",
      "version_exit_code": 0,
      "version_stdout": "1.5.0\n",
      "apply_exit_code": 0,
      "apply_stdout_fixture": "apply-positive.json",
      "expected_route": "markdown-fallback"
    },
    {
      "name": "apply-nonzero",
      "version_exit_code": 0,
      "version_stdout": "1.3.1\n",
      "apply_exit_code": 1,
      "apply_stdout_fixture": "apply-positive.json",
      "expected_route": "markdown-fallback"
    },
    {
      "name": "malformed-json",
      "version_exit_code": 0,
      "version_stdout": "1.3.1\n",
      "apply_exit_code": 0,
      "apply_stdout_fixture": "apply-malformed.txt",
      "expected_route": "markdown-fallback"
    },
    {
      "name": "schema-mismatch",
      "version_exit_code": 0,
      "version_stdout": "1.3.1\n",
      "apply_exit_code": 0,
      "apply_stdout_fixture": "apply-schema-mismatch.json",
      "expected_route": "markdown-fallback"
    },
    {
      "name": "unsafe-path",
      "version_exit_code": 0,
      "version_stdout": "1.3.1\n",
      "apply_exit_code": 0,
      "apply_stdout_fixture": "apply-unsafe-path.json",
      "expected_route": "markdown-fallback"
    },
    {
      "name": "cardinality-mismatch",
      "version_exit_code": 0,
      "version_stdout": "1.3.1\n",
      "apply_exit_code": 0,
      "apply_stdout_fixture": "apply-cardinality-mismatch.json",
      "expected_route": "markdown-fallback"
    },
    {
      "name": "progress-mismatch",
      "version_exit_code": 0,
      "version_stdout": "1.3.1\n",
      "apply_exit_code": 0,
      "apply_stdout_fixture": "apply-progress-mismatch.json",
      "expected_route": "markdown-fallback"
    },
    {
      "name": "blocked-or-missing-artifacts",
      "version_exit_code": 0,
      "version_stdout": "1.3.1\n",
      "apply_exit_code": 0,
      "apply_stdout_fixture": "apply-blocked.json",
      "expected_route": "stop-unprepared"
    },
    {
      "name": "all-done",
      "version_exit_code": 0,
      "version_stdout": "1.3.1\n",
      "apply_exit_code": 0,
      "apply_stdout_fixture": "apply-all-done.json",
      "expected_route": "final-boundary"
    }
  ]
}
