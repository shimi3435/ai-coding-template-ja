diff --git a/syntax/issue51_test.go b/syntax/issue51_test.go
new file mode 100644
index 0000000..09c6389
--- /dev/null
+++ b/syntax/issue51_test.go
@@ -0,0 +1,85 @@
+package syntax_test
+
+import (
+	"mvdan.cc/sh/v3/syntax"
+	"strings"
+	"testing"
+)
+
+func TestIssue51BashCompatibility(t *testing.T) {
+	cases := []struct {
+		name, source string
+		wantTask     bool
+	}{
+		{"shell-combined-redirect-continued-append", "task &>\\\n>/dev/null check:template", true},
+		{"shell-combined-redirect-continued-fd", "task 2>\\\n&1 check:template", true},
+		{"shell-heredoc-header-here-string", "cat <\\\n<<EOF\ntask check:template\n", true},
+		{"shell-heredoc-header-here-document", "cat <\\\n<EOF\ntask check:template\nEOF\n", false},
+		{"shell-heredoc-header-quoted-delimiter", "cat <<\"E\\$F\"\nprintf data\nE$F\ntask check:template\n", true},
+		{"shell-heredoc-payload-joined-delimiter", "cat <<EOF\nEO\\\nF\ntask check:template\n", true},
+		{"shell-heredoc-payload-tabs-joined-delimiter", "cat <<-EOF\n\tEO\\\nF\ntask check:template\n", true},
+		{"shell-heredoc-payload-continued-unquoted-delimiter", "cat <<EO\\\nF\nEO\\\nF\ntask check:template\n", true},
+	}
+	cases = append(cases, struct {
+		name, source string
+		wantTask     bool
+	}{"empty-continuation-delimiter", "<<EOF\n\\\nEOF\ntask check:template\n", true})
+
+	cases = append(cases, struct {
+		name, source string
+		wantTask     bool
+	}{"quoted-prefix", "cat <<'E'OF\nEO\\\nF\ntask check:template\nEOF\n", false})
+
+	cases = append(cases, struct {
+		name, source string
+		wantTask     bool
+	}{"quoted-suffix", "cat <<EO'F'\nEO\\\nF\ntask check:template\nEOF\n", false})
+
+	cases = append(cases, struct {
+		name, source string
+		wantTask     bool
+	}{"quoted-empty-middle", "cat <<E''OF\nEO\\\nF\ntask check:template\nEOF\n", false})
+
+	cases = append(cases, struct {
+		name, source string
+		wantTask     bool
+	}{"quoted-backslash-literal", "cat <<\"E\\qF\"\ntask check:template\nE\\qF\n", false})
+
+	cases = append(cases, struct {
+		name, source string
+		wantTask     bool
+	}{"quoted-payload-no-join", "cat <<'EOF'\nEO\\\nF\ntask check:template\nEOF\n", false})
+
+	cases = append(cases, struct {
+		name, source string
+		wantTask     bool
+	}{"even-backslashes", "cat <<EOF\nEO\\\\\nF\ntask check:template\nEOF\n", false})
+
+	cases = append(cases, struct {
+		name, source string
+		wantTask     bool
+	}{"tab-after-continuation", "cat <<-EOF\nEO\\\n\tF\ntask check:template\nEOF\n", false})
+
+	cases = append(cases, struct {
+		name, source string
+		wantTask     bool
+	}{"multiple-continuations", "cat <<EOF\nE\\\nO\\\nF\ntask check:template\n", true})
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			f, err := syntax.NewParser(syntax.Variant(syntax.LangBash)).Parse(strings.NewReader(c.source), "")
+			if err != nil {
+				t.Fatal(err)
+			}
+			found := false
+			for _, s := range f.Stmts {
+				if call, ok := s.Cmd.(*syntax.CallExpr); ok && len(call.Args) > 1 && call.Args[0].Lit() == "task" && call.Args[1].Lit() == "check:template" {
+					found = true
+				}
+			}
+			if found != c.wantTask {
+				t.Fatalf("task outside payload=%v, want %v", found, c.wantTask)
+			}
+		})
+	}
+}
